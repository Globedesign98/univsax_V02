<div class="border border-light border-opacity-25 rounded-3 overflow-hidden text-white ues-checklist">

  <div class="bg-light bg-opacity-10 px-3 py-2 d-flex align-items-center gap-2">
    <i class="bi bi-check2-circle"></i>
    <span class="fw-semibold">Checklist</span>
  </div>

  <div class="px-3 py-2 border-top border-light border-opacity-25 text-white-50 small">
    <div class="ues-checkline">
      <i class="bi bi-1-circle mt-1"></i>
      <div class="ues-checktext">Form completed and <strong>submitted</strong></div>
      <span class="ues-step-dot  is-done" aria-hidden="true"></span>
    </div>
  </div>

  <div class="px-3 py-2 border-top border-light border-opacity-25 text-white-50 small">
    <div class="ues-checkline">
      <i class="bi bi-2-circle mt-1"></i>
      <div class="ues-checktext">ID photo</div>
      <span class="ues-step-dot  is-done" aria-hidden="true"></span>
    </div>
  </div>

  <div class="px-3 py-2 border-top border-light border-opacity-25 text-white-50 small">
    <div class="ues-checkline">
      <i class="bi bi-3-circle mt-1"></i>
      <div class="ues-checktext">Form <strong>validated</strong> by the administration</div>
      <span class="ues-step-dot " aria-hidden="true"></span>
    </div>
  </div>

  <div class="px-3 py-2 border-top border-light border-opacity-25 text-white-50 small">
    <div class="ues-checkline">
      <i class="bi bi-4-circle mt-1"></i>
      <div class="ues-checktext">Signed copy sent (attachment)</div>
      <span class="ues-step-dot " aria-hidden="true"></span>
    </div>
  </div>
  
  <div class="px-3 py-2 border-top border-light border-opacity-25 text-white-50 small">
    <div class="ues-checkline">
      <i class="bi bi-5-circle mt-1"></i>
      <div class="ues-checktext">Payment completed</div>
      <span class="ues-step-dot  is-done" aria-hidden="true"></span>
    </div>
  </div>

  <div class="px-3 py-2 border-top border-light border-opacity-25 text-white-50 small">
    <div class="ues-checkline">
      <i class="bi bi-6-circle mt-1"></i>
      <div class="ues-checktext">Registration <strong>validated and confirmed</strong> by UES</div>
      <span class="ues-step-dot " aria-hidden="true"></span>
    </div>
  </div>

</div>

