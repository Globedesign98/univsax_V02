a:2:{s:9:"nom_cache";s:38:"646514f3a5dd3980bc94127cda2f53f2.cache";s:6:"valeur";a:12:{s:9:"squelette";s:37:"html_4c6a5d2f8a7ee40a3ed7f288a072f0eb";s:6:"source";s:78:"../plugins/auto/inscription3/v3.7.1/prive/style_prive_plugin_inscription3.html";s:11:"process_ins";s:4:"html";s:11:"invalideurs";a:1:{s:5:"cache";s:38:"646514f3a5dd3980bc94127cda2f53f2.cache";}s:7:"entetes";a:5:{s:12:"X-Spip-Cache";s:6:"360000";s:13:"Cache-Control";s:14:"max-age=360000";s:15:"X-Spip-Statique";s:3:"oui";s:12:"Content-Type";s:29:"text/css; charset=iso-8859-15";s:4:"Vary";s:15:"Accept-Encoding";}s:5:"duree";i:360000;s:5:"texte";s:1207:"
.raccourcis ul,.legend ul{
	list-style-type:none;
	padding-left:30px;
}
.raccourcis li{
	margin-top:5px
}

#principal {
	margin:0%;
}

sup {font-size:60%}

.search_field{
	width:100px
}

#case{
	width:120px
}

.cadre-info {margin-bottom:10px}

td.label,th.label{
	position:relative;
	text-align:left;
	vertical-align:top;
	width:120px;
	display:block;
}

td.label label{
	margin-left:0;
	float:none;
	width:auto;
}

table.spip th{
	vertical-align:middle;
}

table.spip th.both{
	background:#fcc8d9 url(../plugins/auto/inscription3/v3.7.1/images/fle_both.gif) right center no-repeat;
	padding-right:20px;

}

table.spip th.on{
	background-color:#fee4ec;
}

table.spip th.asc{
	background:#fee4ec url(../plugins/auto/inscription3/v3.7.1/images/fle_asc.gif) right center no-repeat;
	padding-right:20px;
}

table.spip th.desc{
	background:#fee4ec url(../plugins/auto/inscription3/v3.7.1/images/fle_desc.gif) right center no-repeat;
	padding-right:20px;
}

table.spip tr.erreur td{
	background-color:#FFD0BF;
}

table.inscription3 th.label{
	width:auto;
}
.formulaire_configurer li.sans_padding{
	padding-left:0;
}

#page .formulaire_spip li.editer_reglement_article > label{
	float:left;
	margin-right:30px;
}
